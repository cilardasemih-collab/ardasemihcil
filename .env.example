# ardasemihcil - completely separate from wamtes
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-ARDASEMIHCIL-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ARDASEMIHCIL_ANON_KEY

# Optional: used if you trigger edge functions from server routes
SUPABASE_SERVICE_ROLE_KEY=YOUR_ARDASEMIHCIL_SERVICE_ROLE_KEY
# Required by Supabase CLI when running `supabase db push`
SUPABASE_DB_PASSWORD=YOUR_ARDASEMIHCIL_DB_PASSWORD

# Google AI (Gemini)
GOOGLE_AI_API_KEY=YOUR_GOOGLE_AI_API_KEY
GOOGLE_AI_MODEL=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash

# Low-cost DesignBuilder defaults
DESIGNBUILDER_SECTION_MAX_TOKENS=1400
DESIGNBUILDER_CONTEXT_LIMIT=3
